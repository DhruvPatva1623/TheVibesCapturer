/* ============================================================
   TheVibesCapturer — Main Stylesheet
   Dark Cinematic | Red + Gold | Camera Aperture Aesthetic
   ============================================================ */

/* ── Google Fonts ─────────────────────────────────────────── */
@import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap");

/* ── CSS Custom Properties ───────────────────────────────── */
:root {
  /* ─── Colors — TVC Cinematic Dark ────────────────────────── */
  --clr-bg:         #111112;
  --clr-bg-2:       #191919;
  --clr-bg-card:    #1e1e1e;
  --clr-bg-3:       #252525;
  --clr-text:       #f5f5f5;
  --clr-text-2:     #9a9a9a;
  --clr-text-3:     #555555;
  /* Red from record-indicator on logo */
  --clr-accent:     #C8282A;
  --clr-accent-2:   #E03A3C;
  --clr-accent-dark:#9e1e20;
  /* Warm yellow from flash on logo */
  --clr-gold:       #F5D580;
  --clr-gold-dark:  #C9A94A;
  --clr-black:      #000000;
  --clr-white:      #ffffff;
  --clr-border:     #2c2c2c;
  --clr-border-2:   #3a3a3a;
  --clr-shadow:     rgba(0,0,0,0.6);
  --clr-shadow-strong: rgba(0,0,0,0.9);
  --clr-success:    #3ecf6e;
  --clr-error:      #e03e3e;
  --clr-warning:    #f59e0b;

  /* Typography */
  --font-body: 'DM Sans', sans-serif;
  --font-display: 'Cormorant Garamond', serif;
  --font-mono: 'DM Mono', monospace;

  /* Spacing */
  --space-xs: 0.5rem;
  --space-sm: 1rem;
  --space-md: 1.5rem;
  --space-lg: 2.5rem;
  --space-xl: 4rem;
  --space-2xl: 6rem;

  /* Radius */
  --radius-sm: 8px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-full: 9999px;

  /* Transitions */
  --trans-fast: 0.15s ease;
  --trans-med: 0.3s ease;
  --trans-slow: 0.6s cubic-bezier(0.23, 1, 0.32, 1);

  /* Nav Height */
  --nav-h: 72px;
}

/* ── Reset & Base ────────────────────────────────────────── */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-body);
  background: var(--clr-bg);
  color: var(--clr-text);
  line-height: 1.65;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

img,
video {
  max-width: 100%;
  display: block;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  cursor: pointer;
  border: none;
  background: none;
  font-family: var(--font-body);
}

/* ── Scrollbar ───────────────────────────────────────────── */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: var(--clr-bg-2);
}
::-webkit-scrollbar-thumb {
  background: var(--clr-accent);
  border-radius: var(--radius-full);
}

/* ── Selection ───────────────────────────────────────────── */
::selection {
  background: var(--clr-accent);
  color: var(--clr-black);
}

/* ═══════════════════════════════════════════════════════════
   NAVBAR
═══════════════════════════════════════════════════════════ */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  height: var(--nav-h);
  display: flex;
  align-items: center;
  padding: 0 var(--space-lg);
  background: rgba(249, 247, 244, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid transparent;
  transition: border-color var(--trans-med), box-shadow var(--trans-med);
}

.navbar.scrolled {
  border-bottom-color: var(--clr-border);
  box-shadow: 0 4px 24px var(--clr-shadow);
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1.1rem;
  color: var(--clr-text);
  letter-spacing: 0.01em;
}

.nav-brand img {
  width: 38px;
  height: 38px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  border: 1px solid var(--clr-border);
}

.brand-text {
  background: linear-gradient(135deg, #ffffff 0%, var(--clr-accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-style: italic;
}

.nav-brand span.brand-text {
  background: linear-gradient(135deg, #f0f0f0, var(--clr-accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin: 0 auto;
  list-style: none;
}

.nav-links a {
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--clr-text-2);
  padding: 0.4rem 0;
  position: relative;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  transition: color var(--trans-fast);
}

.nav-links a:hover,
.nav-links a.active {
  color: var(--clr-accent);
}

.nav-links a::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--clr-accent);
  transition: width var(--trans-med);
  border-radius: var(--radius-full);
}

.nav-links a:hover,
.nav-links a.active {
  color: var(--clr-text);
}

.nav-links a:hover::after,
.nav-links a.active::after {
  width: 100%;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

/* Language Toggle */
.lang-toggle {
  display: flex;
  align-items: center;
  background: var(--clr-bg-2);
  border-radius: var(--radius-full);
  padding: 4px;
  gap: 2px;
}

.lang-btn {
  padding: 4px 12px;
  border-radius: var(--radius-full);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--clr-text-3);
  transition: all var(--trans-fast);
}

.lang-btn.active {
  background: var(--clr-accent);
  color: var(--clr-black);
}

/* Admin Button */
.admin-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 7px 18px;
  background: transparent;
  color: var(--clr-accent);
  border: 1.5px solid var(--clr-accent);
  border-radius: var(--radius-full);
  font-family: var(--font-body);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: all var(--trans-med);
}

.admin-btn:hover {
  background: var(--clr-accent);
  color: var(--clr-black);
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(200,40,42,0.3);
}

.admin-btn.active-admin {
  background: var(--clr-accent);
  color: var(--clr-black);
  border-color: var(--clr-accent);
}

/* Hamburger */
.nav-hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  padding: 8px;
  cursor: pointer;
}

.nav-hamburger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--clr-text);
  border-radius: var(--radius-full);
  transition: all var(--trans-med);
}

/* Mobile Nav */
.mobile-nav {
  display: none;
  position: fixed;
  top: var(--nav-h);
  left: 0;
  right: 0;
  background: var(--clr-bg-card);
  border-bottom: 1px solid var(--clr-border);
  padding: var(--space-md);
  z-index: 999;
  flex-direction: column;
  gap: var(--space-xs);
  box-shadow: 0 8px 32px var(--clr-shadow);
}

.mobile-nav.open {
  display: flex;
}

.mobile-nav a {
  padding: 12px 16px;
  border-radius: var(--radius-sm);
  font-weight: 500;
  color: var(--clr-text-2);
  transition: all var(--trans-fast);
}

.mobile-nav a:hover {
  background: var(--clr-bg-2);
  color: var(--clr-text);
}

/* ═══════════════════════════════════════════════════════════
   HERO SECTION
═══════════════════════════════════════════════════════════ */
.hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  padding-top: var(--nav-h);
  position: relative;
  overflow: hidden;
  background: #0a0a0a;
}

/* Everything absolutely positioned except the 2 main grid items */
.hero-canvas,
.hero-bg,
.floating-orb,
.aperture-3d,
.scroll-indicator {
  position: absolute;
  pointer-events: none;
}

.hero-canvas { inset: 0; z-index: 0; width: 100%; height: 100%; }
.hero-bg { inset: 0; z-index: 0; }
.floating-orb { z-index: 1; }
.aperture-3d { z-index: 1; }
.scroll-indicator { bottom: 2rem; left: 50%; transform: translateX(-50%); z-index: 5; }


.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.07;
}

.hero-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(8, 8, 8, 0.92) 0%,
    rgba(8, 8, 8, 0.7) 50%,
    rgba(8, 8, 8, 0.92) 100%
  );
}

.hero-content {
  position: relative;
  z-index: 3;
  padding: var(--space-lg) var(--space-xl);
  animation: fadeSlideUp 0.8s ease both;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(200,40,42,0.08);
  border: 1px solid rgba(200,40,42,0.2);
  border-radius: var(--radius-full);
  padding: 6px 18px;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--clr-accent);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: var(--space-md);
  backdrop-filter: blur(8px);
}

.hero-badge::before {
  content: "";
  width: 8px;
  height: 8px;
  background: var(--clr-accent);
  border-radius: 50%;
  animation: pulse-dot 2s ease infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.8); }
}

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(3rem, 6vw, 6rem);
  line-height: 1.05;
  color: var(--clr-text);
  margin-bottom: var(--space-md);
  letter-spacing: -0.01em;
}

.hero-line-1 {
  display: block;
  font-weight: 500;
  font-style: italic;
  color: var(--clr-text);
}

.hero-line-2 {
  display: block;
  font-weight: 700;
  font-size: 90%;
}

.hero-tagline {
  font-family: var(--font-display);
  font-size: clamp(1rem, 2vw, 1.3rem);
  color: var(--clr-text-3);
  font-weight: 400;
  margin-bottom: var(--space-lg);
  font-style: italic;
  letter-spacing: 0.02em;
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  margin-bottom: var(--space-lg);
}

.stat-divider {
  width: 1px;
  height: 40px;
  background: var(--clr-border);
  flex-shrink: 0;
}

.stat-item {
  text-align: left;
}

.stat-number {
  font-family: var(--font-display);
  font-size: 2.4rem;
  font-weight: 700;
  color: var(--clr-accent);
  line-height: 1;
  display: block;
  font-style: italic;
}

.stat-label {
  font-size: 0.72rem;
  color: var(--clr-text-3);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 500;
}

.hero-cta {
  display: flex;
  gap: var(--space-sm);
  flex-wrap: wrap;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 32px;
  background: var(--clr-accent);
  color: var(--clr-black);
  border-radius: var(--radius-full);
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: all var(--trans-med);
  box-shadow: 0 4px 24px rgba(200,40,42,0.25);
}

.btn-primary:hover {
  background: var(--clr-accent-2);
  color: var(--clr-black);
  transform: translateY(-3px);
  box-shadow: 0 10px 32px rgba(200,40,42,0.40);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 32px;
  background: transparent;
  color: var(--clr-text);
  border: 1.5px solid var(--clr-border-2);
  border-radius: var(--radius-full);
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  transition: all var(--trans-med);
}

.btn-secondary:hover {
  border-color: var(--clr-accent);
  color: var(--clr-accent);
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(200,40,42,0.15);
}

.hero-visual {
  position: relative;
  z-index: 1;
  padding: var(--space-2xl) var(--space-xl) var(--space-2xl) 0;
  animation: fadeSlideUp 0.8s 0.2s ease both;
}

.hero-card-stack {
  position: relative;
  width: 100%;
  max-width: 420px;
  aspect-ratio: 4/3;
  margin-left: auto;
}

.hero-card {
  position: absolute;
  width: 80%;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 20px 60px var(--clr-shadow-strong);
}

.hero-card-main {
  inset: 0;
  width: 85%;
  right: 0;
  left: auto;
  top: 10%;
}

.hero-card-thumb {
  width: 55%;
  bottom: 0;
  left: 0;
  top: auto;
  border: 4px solid var(--clr-bg);
}

.hero-card img,
.hero-card video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-card-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: rgba(200, 169, 110, 0.9);
  backdrop-filter: blur(8px);
  color: var(--clr-black);
  padding: 4px 10px;
  border-radius: var(--radius-full);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

/* ── Floating Decorative Elements ─────────────────────────── */
.floating-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.orb-1 {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(200,40,42,0.06) 0%, rgba(200,40,42,0.02) 40%, transparent 70%);
  top: -80px;
  right: -120px;
  animation: floatOrb 10s ease-in-out infinite;
}

.orb-2 {
  width: 300px;
  height: 300px;
  background: radial-gradient(circle, rgba(200,40,42,0.04) 0%, transparent 70%);
  bottom: 10%;
  left: -60px;
  animation: floatOrb 8s 2s ease-in-out infinite;
}

.orb-3 {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
  width: 200px;
  height: 200px;
  background: radial-gradient(circle, rgba(255,255,255,0.02) 0%, transparent 70%);
  top: 50%;
  left: 38%;
  animation: floatOrb 12s 1s ease-in-out infinite;
}

@keyframes floatOrb {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20px) scale(1.05); }
}

/* ── Scroll indicator ─────────────────────────────────────── */
.scroll-indicator {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: var(--clr-text-3);
  font-size: 0.75rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  animation: bounce 2s ease infinite;
}

.scroll-indicator svg {
  width: 20px;
  height: 20px;
}

@keyframes bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(8px); }
}

/* ═══════════════════════════════════════════════════════════
   SECTION COMMONS
═══════════════════════════════════════════════════════════ */
section {
  padding: var(--space-2xl) 0;
}

.container {
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 var(--space-lg);
}

.section-header {
  text-align: center;
  margin-bottom: var(--space-xl);
}

.section-eyebrow {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--clr-accent);
  margin-bottom: var(--space-xs);
  opacity: 0.8;
}

.section-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.15;
  color: var(--clr-text);
  font-weight: 600;
  margin-bottom: var(--space-sm);
  font-style: italic;
}

.section-subtitle {
  font-size: 0.95rem;
  color: var(--clr-text-2);
  max-width: 520px;
  margin: 0 auto;
  font-weight: 400;
  line-height: 1.8;
}

/* ── Divider ──────────────────────────────────────────────── */
.divider {
  width: 40px;
  height: 1px;
  background: linear-gradient(90deg, var(--clr-accent), transparent);
  margin: var(--space-sm) auto 0;
}

/* ═══════════════════════════════════════════════════════════
   STATS SECTION
═══════════════════════════════════════════════════════════ */
.stats-section {
  background: #000000;
  color: var(--clr-white);
  padding: var(--space-xl) 0;
  overflow: hidden;
  position: relative;
  border-top: 1px solid var(--clr-border);
  border-bottom: 1px solid var(--clr-border);
}

.stats-section::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 10% 50%, rgba(200,40,42,0.04) 0%, transparent 50%),
    radial-gradient(ellipse at 90% 50%, rgba(200,40,42,0.03) 0%, transparent 50%);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-md);
  position: relative;
  z-index: 1;
}

.stat-card {
  text-align: center;
  padding: var(--space-md) var(--space-lg);
  border-right: 1px solid rgba(255,255,255,0.07);
  position: relative;
}

.stat-card:last-child {
  border-right: none;
}

.stat-card .num {
  font-size: clamp(2rem, 4vw, 3.5rem);
  font-weight: 900;
  background: linear-gradient(135deg, #F5D580, #F5D580);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
  line-height: 1;
  margin-bottom: 8px;
}

.stat-card .label {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.5);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-weight: 500;
  font-family: var(--font-mono);
}

/* Interests card ticker */
.interests-card {
  overflow: hidden;
}

.interests-scroll {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 10px;
  max-height: 56px;
  overflow: hidden;
  mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
}

.interests-scroll span {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.58rem;
  color: rgba(255,255,255,0.45);
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-full);
  padding: 3px 8px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
}

/* ═══════════════════════════════════════════════════════════
   GALLERY SECTION
═══════════════════════════════════════════════════════════ */
.gallery-section {
  background: var(--clr-bg);
}

/* Filter Tabs */
.filter-tabs {
  display: flex;
  justify-content: center;
  gap: var(--space-xs);
  flex-wrap: wrap;
  margin-bottom: var(--space-xl);
}

.filter-tab {
  padding: 10px 22px;
  border-radius: var(--radius-full);
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--clr-text-2);
  background: var(--clr-bg-2);
  border: 1px solid transparent;
  transition: all var(--trans-med);
}

.filter-tab:hover {
  background: rgba(200,40,42,0.1);
  color: var(--clr-accent);
  border-color: rgba(200,40,42,0.3);
  transform: translateY(-1px);
}

.filter-tab.active {
  background: linear-gradient(135deg, var(--clr-accent), var(--clr-accent-dark));
  border-color: transparent;
  color: var(--clr-white);
  box-shadow: 0 4px 16px rgba(200,40,42,0.35);
  transform: translateY(-1px);
}

/* Gallery Grid */
.gallery-grid {
  columns: 3;
  column-gap: var(--space-sm);
}

.gallery-item {
  break-inside: avoid;
  margin-bottom: var(--space-sm);
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--clr-bg-2);
  cursor: pointer;
  transition: transform var(--trans-med), box-shadow var(--trans-med);
}

.gallery-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px var(--clr-shadow-strong);
}

.gallery-item img,
.gallery-item video {
  width: 100%;
  height: auto;
  display: block;
  transition: transform var(--trans-slow);
}

.gallery-item:hover img,
.gallery-item:hover video {
  transform: scale(1.04);
}

.gallery-item-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(13, 13, 26, 0.9) 0%, transparent 60%);
  opacity: 0;
  transition: opacity var(--trans-med);
  display: flex;
  align-items: flex-end;
  padding: var(--space-md);
}

.gallery-item:hover .gallery-item-overlay {
  opacity: 1;
}

.gallery-item-info {
  color: var(--clr-white);
}

.gallery-item-title {
  font-size: 0.95rem;
  font-weight: 700;
  margin-bottom: 4px;
}

.gallery-item-category {
  font-size: 0.75rem;
  color: var(--clr-accent);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.gallery-item-type-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  background: rgba(13, 13, 26, 0.75);
  backdrop-filter: blur(8px);
  color: var(--clr-white);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
}

.gallery-empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: var(--space-2xl);
  color: var(--clr-text-3);
}

.gallery-empty .empty-icon {
  font-size: 4rem;
  margin-bottom: var(--space-sm);
  opacity: 0.4;
}

/* ── Load More ────────────────────────────────────────────── */
.load-more-wrap {
  text-align: center;
  margin-top: var(--space-xl);
}

/* ═══════════════════════════════════════════════════════════
   VIDEO REEL SECTION
═══════════════════════════════════════════════════════════ */
.reel-section {
  background: var(--clr-bg-2);
  position: relative;
  overflow: hidden;
}

.reel-player {
  position: relative;
  width: 100%;
  max-width: 900px;
  margin: 0 auto;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 24px 80px var(--clr-shadow-strong);
  background: var(--clr-black);
}

.reel-player video {
  width: 100%;
  aspect-ratio: 16/9;
  object-fit: contain;
}

.reel-placeholder {
  width: 100%;
  aspect-ratio: 16/9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: var(--space-sm);
  background: linear-gradient(135deg, #1a1a2e 0%, #0d0d1a 100%);
  color: var(--clr-white);
}

.reel-placeholder .play-icon {
  width: 80px;
  height: 80px;
  background: rgba(200, 169, 110, 0.2);
  border: 2px solid var(--clr-accent);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.8rem;
  transition: all var(--trans-med);
}

.reel-playlist {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.reel-thumb {
  border-radius: var(--radius-sm);
  overflow: hidden;
  cursor: pointer;
  position: relative;
  background: var(--clr-bg);
  transition: all var(--trans-med);
  border: 2px solid transparent;
}

.reel-thumb.active {
  border-color: var(--clr-accent);
}

.reel-thumb:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px var(--clr-shadow-strong);
}

.reel-thumb img,
.reel-thumb video {
  width: 100%;
  aspect-ratio: 16/9;
  object-fit: cover;
}

.reel-thumb-title {
  padding: 8px 10px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--clr-text-2);
}

/* ═══════════════════════════════════════════════════════════
   BEFORE & AFTER SECTION
═══════════════════════════════════════════════════════════ */
.ba-section {
  background: var(--clr-bg);
}

.ba-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: var(--space-lg);
}

.ba-card {
  background: var(--clr-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 4px 24px var(--clr-shadow);
  transition: transform var(--trans-med), box-shadow var(--trans-med);
}

.ba-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 48px var(--clr-shadow-strong);
}

.ba-images {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
}

.ba-images img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
}

.ba-labels {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
}

.ba-label {
  padding: 6px 12px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.ba-label-before {
  background: var(--clr-bg-2);
  color: var(--clr-text-2);
}

.ba-label-after {
  background: var(--clr-accent);
  color: var(--clr-black);
}

.ba-info {
  padding: var(--space-md);
}

.ba-title {
  font-weight: 700;
  font-size: 1rem;
  color: var(--clr-text);
  margin-bottom: 6px;
}

.ba-desc {
  font-size: 0.88rem;
  color: var(--clr-text-2);
}

/* ═══════════════════════════════════════════════════════════
   SERVICES SECTION
═══════════════════════════════════════════════════════════ */
.services-section {
  background: var(--clr-bg-2);
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--space-md);
}

.service-card {
  background: var(--clr-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  border: 1px solid var(--clr-border);
  transition: all var(--trans-med);
  position: relative;
  overflow: hidden;
}

.service-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--clr-accent), var(--clr-accent-2));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--trans-med);
  border-radius: var(--radius-full);
}

.service-card:hover::before {
  transform: scaleX(1);
}

.service-card:hover {
  box-shadow: 0 12px 40px var(--clr-shadow-strong);
  transform: translateY(-4px);
  border-color: transparent;
}

.service-icon {
  width: 48px;
  height: 48px;
  background: rgba(200,40,42,0.08);
  border: 1px solid rgba(200,40,42,0.15);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  margin-bottom: var(--space-md);
  transition: all var(--trans-med);
}

.service-card:hover .service-icon {
  background: rgba(200,40,42,0.15);
  border-color: rgba(200,40,42,0.3);
  transform: scale(1.08);
}

.service-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 600;
  font-style: italic;
  color: var(--clr-text);
  margin-bottom: var(--space-xs);
}

.service-desc {
  font-size: 0.88rem;
  color: var(--clr-text-2);
  line-height: 1.75;
  font-weight: 400;
}

/* ═══════════════════════════════════════════════════════════
   TESTIMONIALS SECTION
═══════════════════════════════════════════════════════════ */
.testimonials-section {
  background: var(--clr-bg);
}

.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: var(--space-md);
}

.testimonial-card {
  background: var(--clr-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: 0 4px 24px var(--clr-shadow);
  position: relative;
  transition: all var(--trans-med);
}

.testimonial-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 48px var(--clr-shadow-strong);
}

.testimonial-card::before {
  content: "\201C";
  position: absolute;
  top: 16px;
  right: 24px;
  font-family: var(--font-display);
  font-size: 6rem;
  color: rgba(200, 169, 110, 0.12);
  line-height: 1;
}

.testimonial-stars {
  color: var(--clr-accent);
  margin-bottom: var(--space-sm);
  font-size: 0.9rem;
  letter-spacing: 2px;
}

.testimonial-text {
  font-family: var(--font-display);
  font-size: 1.05rem;
  color: var(--clr-text-2);
  line-height: 1.9;
  margin-bottom: var(--space-md);
  font-style: italic;
  font-weight: 400;
}

.testimonial-author {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.testimonial-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--clr-accent), var(--clr-accent-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 1rem;
  color: var(--clr-black);
  flex-shrink: 0;
}

.testimonial-name {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1rem;
  color: var(--clr-text);
}

.testimonial-role {
  font-size: 0.75rem;
  color: var(--clr-text-3);
  letter-spacing: 0.04em;
}

/* ═══════════════════════════════════════════════════════════
   CONTACT SECTION
═══════════════════════════════════════════════════════════ */
.contact-section {
  background: var(--clr-bg-2);
}

.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: var(--space-xl);
  align-items: start;
}

.contact-info h3 {
  font-family: var(--font-display);
  font-size: 1.8rem;
  color: var(--clr-text);
  margin-bottom: var(--space-sm);
}

.contact-info p {
  color: var(--clr-text-2);
  margin-bottom: var(--space-lg);
  line-height: 1.8;
}

.contact-methods {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.contact-method {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 18px;
  background: var(--clr-bg-card);
  border-radius: var(--radius-md);
  border: 1px solid var(--clr-border);
  transition: all var(--trans-med);
}

.contact-method:hover {
  border-color: var(--clr-accent);
  box-shadow: 0 4px 16px var(--clr-shadow);
}

.contact-method-icon {
  width: 42px;
  height: 42px;
  background: transparent;
  border: 1px solid var(--clr-border-2);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  font-family: var(--font-mono);
  color: var(--clr-accent);
  flex-shrink: 0;
  font-weight: 500;
}

.contact-method-label {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--clr-text-3);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.contact-method-value {
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--clr-text);
  margin-top: 2px;
}

/* Contact Form */
.contact-form {
  background: var(--clr-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
  box-shadow: 0 8px 40px var(--clr-shadow);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-sm);
}

.form-group {
  margin-bottom: var(--space-md);
}

.form-label {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--clr-text-2);
  margin-bottom: 8px;
}

.form-input,
.form-textarea,
.form-select {
  width: 100%;
  padding: 12px 16px;
  background: var(--clr-bg);
  border: 1.5px solid var(--clr-border);
  border-radius: var(--radius-sm);
  font-family: var(--font-body);
  font-size: 0.92rem;
  color: var(--clr-text);
  transition: border-color var(--trans-fast), box-shadow var(--trans-fast);
  outline: none;
}

.form-input:focus,
.form-textarea:focus,
.form-select:focus {
  border-color: var(--clr-accent);
  box-shadow: 0 0 0 3px rgba(200, 169, 110, 0.12);
}

.form-textarea {
  resize: vertical;
  min-height: 140px;
}

.form-submit {
  width: 100%;
  padding: 14px;
  background: var(--clr-accent);
  color: var(--clr-black);
  border-radius: var(--radius-full);
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: all var(--trans-med);
  box-shadow: 0 4px 20px rgba(200,40,42,0.2);
}

.form-submit:hover {
  background: var(--clr-accent-2);
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(200,40,42,0.35);
}

/* ═══════════════════════════════════════════════════════════
   FOOTER
═══════════════════════════════════════════════════════════ */
footer {
  background: #000000;
  color: rgba(255, 255, 255, 0.5);
  padding: var(--space-xl) 0 var(--space-md);
  position: relative;
  overflow: hidden;
  border-top: 1px solid var(--clr-border);
}

footer::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(200,40,42,0.3), transparent);
}

.footer-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  padding-bottom: var(--space-xl);
  text-align: center;
}

.footer-brand-link {
  color: var(--clr-white);
}

.footer-tagline {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 1rem;
  color: rgba(255,255,255,0.35);
  letter-spacing: 0.04em;
}

.footer-socials {
  display: flex;
  gap: var(--space-sm);
}

.social-link {
  width: 42px;
  height: 42px;
  background: rgba(200,40,42,0.06);
  border: 1px solid var(--clr-border-2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.4);
  transition: all var(--trans-fast);
}

.social-link:hover {
  background: var(--clr-accent);
  border-color: var(--clr-accent);
  color: var(--clr-black);
  transform: translateY(-3px);
  box-shadow: 0 6px 16px rgba(200,40,42,0.25);
}

.footer-bottom {
  border-top: 1px solid var(--clr-border);
  padding-top: var(--space-md);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: rgba(255,255,255,0.2);
  letter-spacing: 0.05em;
}

.footer-bottom a {
  color: var(--clr-accent);
}

/* ═══════════════════════════════════════════════════════════
   LIGHTBOX / MODAL
═══════════════════════════════════════════════════════════ */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 9000;
  background: rgba(13, 13, 26, 0.96);
  display: none;
  align-items: center;
  justify-content: center;
  padding: var(--space-md);
}

.lightbox.open {
  display: flex;
}

.lightbox-inner {
  max-width: 900px;
  width: 100%;
  background: var(--clr-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  animation: fadeSlideUp 0.3s ease both;
}

.lightbox-media {
  background: var(--clr-black);
  display: flex;
  align-items: center;
  justify-content: center;
  max-height: 70vh;
  overflow: hidden;
}

.lightbox-media img,
.lightbox-media video {
  max-width: 100%;
  max-height: 70vh;
  object-fit: contain;
}

.lightbox-info {
  padding: var(--space-md) var(--space-lg);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-md);
}

.lightbox-title {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--clr-text);
  margin-bottom: 4px;
}

.lightbox-desc {
  font-size: 0.88rem;
  color: var(--clr-text-2);
}

.lightbox-close {
  width: 40px;
  height: 40px;
  background: var(--clr-bg-2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  color: var(--clr-text);
  flex-shrink: 0;
  transition: all var(--trans-fast);
}

.lightbox-close:hover {
  background: var(--clr-accent);
  color: var(--clr-black);
}

.lightbox-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--clr-white);
  font-size: 1.2rem;
  transition: all var(--trans-fast);
}

.lightbox-nav:hover {
  background: var(--clr-accent);
  color: var(--clr-black);
}

.lightbox-prev { left: 16px; }
.lightbox-next { right: 16px; }

/* ═══════════════════════════════════════════════════════════
   ADMIN PANEL
═══════════════════════════════════════════════════════════ */
.admin-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(13, 13, 26, 0.5);
  backdrop-filter: blur(4px);
  display: none;
  align-items: center;
  justify-content: center;
}

.admin-overlay.open {
  display: flex;
}

/* Admin Login Modal */
.admin-login-modal {
  background: var(--clr-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
  width: 100%;
  max-width: 400px;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.4);
  animation: fadeSlideUp 0.3s ease both;
  text-align: center;
}

.admin-login-icon {
  width: 64px;
  height: 64px;
  background: var(--clr-bg-2);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-size: 1.5rem;
  color: var(--clr-accent);
  margin: 0 auto var(--space-md);
}

.admin-login-modal h2 {
  font-family: var(--font-display);
  font-size: 1.6rem;
  font-style: italic;
  font-weight: 600;
  color: var(--clr-text);
  margin-bottom: 8px;
}

.admin-login-modal p {
  font-size: 0.88rem;
  color: var(--clr-text-2);
  margin-bottom: var(--space-lg);
}

.admin-login-form {
  text-align: left;
}

.login-error {
  display: none;
  background: rgba(231, 76, 60, 0.1);
  border: 1px solid rgba(231, 76, 60, 0.3);
  color: var(--clr-error);
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  font-size: 0.85rem;
  margin-bottom: var(--space-sm);
}

.login-error.show {
  display: block;
}

/* Admin Panel Sidebar */
.admin-panel {
  position: fixed;
  top: 0;
  right: -100%;
  width: 100%;
  max-width: 560px;
  height: 100vh;
  background: var(--clr-bg-card);
  z-index: 9998;
  display: flex;
  flex-direction: column;
  box-shadow: -8px 0 48px var(--clr-shadow-strong);
  transition: right var(--trans-slow);
  overflow: hidden;
}

.admin-panel.open {
  right: 0;
}

.admin-panel-header {
  background: #0a0a0a;
  color: var(--clr-white);
  padding: var(--space-md) var(--space-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  border-bottom: 1px solid var(--clr-border);
}

.admin-panel-title {
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: 0.02em;
}

.admin-panel-close {
  width: 36px;
  height: 36px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  color: var(--clr-white);
  transition: all var(--trans-fast);
}

.admin-panel-close:hover {
  background: var(--clr-accent);
  color: var(--clr-black);
}

.admin-panel-body {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-lg);
}

.admin-tabs {
  display: flex;
  background: var(--clr-bg-2);
  border-radius: var(--radius-sm);
  padding: 4px;
  gap: 4px;
  margin-bottom: var(--space-lg);
}

.admin-tab {
  flex: 1;
  padding: 10px;
  border-radius: calc(var(--radius-sm) - 2px);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--clr-text-2);
  transition: all var(--trans-fast);
  text-align: center;
}

.admin-tab.active {
  background: var(--clr-accent);
  color: var(--clr-black);
  box-shadow: 0 2px 10px rgba(200,40,42,0.2);
}

.admin-tab-content {
  display: none;
}

.admin-tab-content.active {
  display: block;
}

/* Upload Zone */
.upload-zone {
  border: 2px dashed var(--clr-border);
  border-radius: var(--radius-md);
  padding: var(--space-xl);
  text-align: center;
  cursor: pointer;
  transition: all var(--trans-med);
  background: var(--clr-bg);
  margin-bottom: var(--space-lg);
}

.upload-zone:hover,
.upload-zone.drag-over {
  border-color: var(--clr-accent);
  background: rgba(200, 169, 110, 0.05);
}

.upload-zone-icon {
  font-size: 3rem;
  margin-bottom: var(--space-sm);
  opacity: 0.6;
}

.upload-zone-text {
  font-weight: 700;
  color: var(--clr-text);
  margin-bottom: 4px;
}

.upload-zone-hint {
  font-size: 0.82rem;
  color: var(--clr-text-3);
}

.upload-zone input[type="file"] {
  display: none;
}

/* Upload Form */
.upload-form-fields {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.upload-preview {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: var(--space-md);
}

.upload-preview-item {
  aspect-ratio: 1;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--clr-bg-2);
  position: relative;
}

.upload-preview-item img,
.upload-preview-item video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.upload-preview-remove {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 24px;
  height: 24px;
  background: rgba(231, 76, 60, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  color: var(--clr-white);
  cursor: pointer;
  transition: all var(--trans-fast);
}

/* Progress Bar */
.upload-progress {
  margin-bottom: var(--space-sm);
}

.progress-label {
  display: flex;
  justify-content: space-between;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--clr-text-2);
  margin-bottom: 6px;
}

.progress-bar {
  height: 6px;
  background: var(--clr-bg-2);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--clr-accent), var(--clr-accent-2));
  border-radius: var(--radius-full);
  transition: width 0.3s ease;
  width: 0%;
  box-shadow: 0 0 8px rgba(200,40,42,0.3);
}

/* Admin Media List */
.admin-media-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.admin-media-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  background: var(--clr-bg);
  border-radius: var(--radius-sm);
  border: 1px solid var(--clr-border);
  transition: all var(--trans-fast);
}

.admin-media-item:hover {
  border-color: var(--clr-accent);
  box-shadow: 0 2px 12px var(--clr-shadow);
}

.admin-media-thumb {
  width: 52px;
  height: 52px;
  border-radius: 8px;
  overflow: hidden;
  background: var(--clr-bg-2);
  flex-shrink: 0;
}

.admin-media-thumb img,
.admin-media-thumb video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.admin-media-info {
  flex: 1;
  min-width: 0;
}

.admin-media-name {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--clr-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 2px;
}

.admin-media-meta {
  font-size: 0.75rem;
  color: var(--clr-text-3);
}

.admin-media-actions {
  display: flex;
  gap: 6px;
  flex-shrink: 0;
}

.admin-action-btn {
  width: 30px;
  height: 30px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  transition: all var(--trans-fast);
}

.admin-action-edit {
  background: rgba(200,40,42,0.08);
  color: var(--clr-accent);
}

.admin-action-edit:hover {
  background: var(--clr-accent);
  color: var(--clr-black);
}

.admin-action-delete {
  background: rgba(231, 76, 60, 0.1);
  color: var(--clr-error);
}

.admin-action-delete:hover {
  background: var(--clr-error);
  color: var(--clr-white);
}

/* Storage Stats Bar */
.storage-stats {
  background: var(--clr-bg);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-lg);
  border: 1px solid var(--clr-border);
}

.storage-stats-title {
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--clr-text-2);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: var(--space-sm);
}

.storage-bar {
  height: 8px;
  background: var(--clr-bg-2);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin-bottom: 8px;
}

.storage-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--clr-accent), var(--clr-accent-2));
  border-radius: var(--radius-full);
  transition: width 0.5s ease;
  box-shadow: 0 0 8px rgba(200,40,42,0.3);
}

.storage-numbers {
  display: flex;
  justify-content: space-between;
  font-size: 0.78rem;
  color: var(--clr-text-3);
}

/* Admin Stats Grid */
.admin-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: var(--space-lg);
}

.admin-stat-chip {
  background: var(--clr-bg);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-sm);
  padding: 14px;
  text-align: center;
}

.admin-stat-chip .num {
  font-size: 1.6rem;
  font-weight: 900;
  background: linear-gradient(135deg, var(--clr-accent), var(--clr-accent-dark));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
}

.admin-stat-chip .label {
  font-size: 0.72rem;
  color: var(--clr-text-3);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* ── Toast Notifications ──────────────────────────────────── */
.toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 99999;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
}

.toast {
  background: var(--clr-bg-card);
  border-radius: var(--radius-md);
  padding: 14px 20px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.5), 0 2px 8px var(--clr-shadow);
  border-left: 4px solid var(--clr-accent);
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--clr-text);
  animation: toastSlideIn 0.3s ease both;
  pointer-events: all;
  max-width: 340px;
  backdrop-filter: blur(12px);
}

.toast.success { border-left-color: var(--clr-success); }
.toast.error { border-left-color: var(--clr-error); }
.toast.warning { border-left-color: var(--clr-warning); }

@keyframes toastSlideIn {
  from { transform: translateX(120%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

@keyframes toastSlideOut {
  from { transform: translateX(0); opacity: 1; }
  to { transform: translateX(120%); opacity: 0; }
}

/* ── Animations ───────────────────────────────────────────── */
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.fade-in.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── Utility Classes ─────────────────────────────────────── */
.text-accent { color: var(--clr-accent); }
.text-center { text-align: center; }
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

/* ── Alternate Section BG ─────────────────────────────────── */
.bg-alt { background: var(--clr-bg-2); }
.bg-dark { background: var(--clr-text); color: var(--clr-white); }

/* ── Badge ────────────────────────────────────────────────── */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 3px 10px;
  border-radius: var(--radius-full);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.badge-photo { background: rgba(200,40,42,0.12); color: #1a6fd4; }
.badge-video { background: rgba(220, 50, 50, 0.10); color: #b91c1c; }
.badge-edited { background: rgba(200,40,42,0.15); color: var(--clr-accent-dark); }
.badge-other { background: rgba(100,116,139,0.12); color: #475569; }

/* ═══════════════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════════════ */
@media (max-width: 1024px) {
  .gallery-grid { columns: 2; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .stats-grid .stat-card { border-right: none; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .stats-grid .stat-card:last-child, .stats-grid .stat-card:nth-child(3) { border-bottom: none; }
  .hero { grid-template-columns: 1fr; }
  .hero-visual { display: none; }
  .hero-content { padding: calc(var(--space-2xl) + 2rem) var(--space-lg) var(--space-2xl); max-width: 640px; margin: 0 auto; }
  .contact-layout { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr 1fr; }
  .reel-playlist { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
  :root { --space-2xl: 4rem; --space-xl: 2.5rem; }
  .nav-links { display: none; }
  .nav-hamburger { display: flex; }
  .gallery-grid { columns: 1; }
  .hero-stats { flex-wrap: wrap; gap: var(--space-md); }
  .form-row { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr; gap: var(--space-lg); }
  .footer-bottom { flex-direction: column; gap: var(--space-xs); text-align: center; }
  .admin-panel { max-width: 100%; }
  .ba-grid { grid-template-columns: 1fr; }
  .admin-stats-grid { grid-template-columns: repeat(4, 1fr); }
  .reel-playlist { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 480px) {
  .hero-cta { flex-direction: column; }
  .btn-primary, .btn-secondary { justify-content: center; }
  .admin-stats-grid { grid-template-columns: repeat(2, 1fr); }
  .upload-preview { grid-template-columns: repeat(2, 1fr); }
  .services-grid, .testimonials-grid { grid-template-columns: 1fr; }
  .lang-toggle { display: none; }
}

/* ═══════════════════════════════════════════════════════════
   3D ELEMENTS & APERTURE
═══════════════════════════════════════════════════════════ */

/* Hero canvas — full-screen 3D background */
.hero-canvas {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* Aperture 3D rings */
.aperture-3d {
  position: absolute;
  right: 5%;
  top: 50%;
  transform: translateY(-50%);
  width: 520px;
  height: 520px;
  z-index: 1;
  pointer-events: none;
}

.aperture-ring {
  position: absolute;
  border-radius: 50%;
  inset: 0;
}

.aperture-svg {
  width: 100%;
  height: 100%;
  animation: apertureSpinSlow 24s linear infinite;
}

.aperture-blades {
  transform-origin: 100px 100px;
  animation: apertureSpinFast 8s linear infinite;
}

.ring-2 {
  inset: 12%;
  border: 1px solid rgba(200, 40, 42, 0.18);
  animation: apertureSpinSlow 18s linear infinite reverse;
  box-shadow:
    inset 0 0 40px rgba(200,40,42,0.04),
    0 0 60px rgba(200,40,42,0.05);
}

.ring-3 {
  inset: 26%;
  border: 1px solid rgba(245, 213, 128, 0.15);
  animation: apertureSpinSlow 12s linear infinite;
  box-shadow:
    inset 0 0 30px rgba(245,213,128,0.05),
    0 0 40px rgba(245,213,128,0.04);
}

.aperture-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10px;
  height: 10px;
  background: var(--clr-accent);
  border-radius: 50%;
  box-shadow: 0 0 20px rgba(200,40,42,0.8), 0 0 40px rgba(200,40,42,0.4);
  animation: dotPulse 2.5s ease-in-out infinite;
}

@keyframes apertureSpinSlow {
  to { transform: rotate(360deg); }
}

@keyframes apertureSpinFast {
  to { transform: rotate(360deg); }
}

@keyframes dotPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1.6); opacity: 0.5; }
}

/* Card 3D tilt */
.tilt-card,
.card-3d {
  transform-style: preserve-3d;
  will-change: transform;
  transition: transform var(--trans-med), box-shadow var(--trans-med) !important;
}

.card-3d-shine {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  z-index: 10;
  transition: background 0.1s ease;
}

/* Film strip decorative lines */
.hero::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 24px;
  background:
    repeating-linear-gradient(
      180deg,
      transparent 0,
      transparent 32px,
      rgba(255,255,255,0.04) 32px,
      rgba(255,255,255,0.04) 48px
    );
  z-index: 2;
  pointer-events: none;
}

/* Interests CTA hint */
.interests-cta {
  margin-top: 10px;
  font-size: 0.65rem;
  color: var(--clr-accent);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-family: var(--font-mono);
  opacity: 0.7;
  transition: opacity var(--trans-fast);
}

.interests-card:hover .interests-cta {
  opacity: 1;
}

/* Mobile nav Fields link */
.mobile-nav a[href="fields.html"] {
  color: var(--clr-accent);
}

/* Hero section content above canvas */
.hero-content,
.hero-visual,
.aperture-3d,
.floating-orb,
.scroll-indicator {
  position: relative;
  z-index: 3;
}

.hero-bg {
  position: absolute;
  z-index: 1;
}

/* Scrollbar to match new logo red */
::-webkit-scrollbar-thumb {
  background: var(--clr-accent);
}

/* Section eyebrow red dot */
.section-eyebrow::before {
  content: '●';
  margin-right: 6px;
  font-size: 0.5em;
  color: var(--clr-accent);
  vertical-align: middle;
}

/* Red record dot on nav brand (decorative) */
.nav-brand::after {
  content: '';
  display: inline-block;
  width: 6px;
  height: 6px;
  background: var(--clr-accent);
  border-radius: 50%;
  margin-left: 6px;
  margin-bottom: 10px;
  box-shadow: 0 0 6px rgba(200,40,42,0.6);
  animation: dotPulse 2s ease-in-out infinite;
  flex-shrink: 0;
}

/* Hover state red glow on service icon */
.service-card:hover .service-icon {
  background: rgba(200,40,42,0.1);
  border-color: rgba(200,40,42,0.25);
  box-shadow: 0 0 20px rgba(200,40,42,0.1);
}

/* Gold flash bar accent on hero stats num */
.stat-card .num {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 600;
  font-style: italic;
  background: linear-gradient(135deg, #ffffff 0%, var(--clr-gold) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
  line-height: 1;
  margin-bottom: 8px;
}

/* Active nav link gold underline */
.nav-links a::after {
  background: var(--clr-gold);
}

/* Fields page nav item glow */
#nav-fields {
  color: var(--clr-gold) !important;
  font-weight: 600 !important;
}

/* Responsive aperture */
@media (max-width: 900px) {
  .aperture-3d {
    width: 300px;
    height: 300px;
    right: 2%;
    opacity: 0.5;
  }
}

@media (max-width: 600px) {
  .aperture-3d { display: none; }
}


